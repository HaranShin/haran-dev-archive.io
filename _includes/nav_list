<!-- navigation 변수 가져오기 -->
{% assign navigation = site.data.navigation[include.nav] %}

<!-- 카테고리별 글 개수 중 가장 큰 값(MAX) 찾기 -->
{% assign categories_max = 0 %}
{% for category in site.categories %}
  {% if category.size > categories_max %}
    {% assign categories_max = category.size %}
  {% endif %}
{% endfor %}

<nav class="nav__list">
  <!-- 접기/펼치기 토글 버튼 (모바일용 기본 메뉴) -->
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ site.data.ui-text[site.locale].menu_label | default: "Toggle Menu" }}</label>

  <ul class="nav__items">
    {% for nav_item in navigation %}
      <li>
        <!-- [수정] 스크립트 에러를 원천 차단하기 위해 onclick 안에 직접 작동 명령어를 심었습니다 -->
        <span class="nav__sub-title" 
              onclick="var el = document.getElementById('menu-{{ nav_item.title | slugify }}'); if(el.style.display==='none'){el.style.display='block';}else{el.style.display='none';}" 
              style="cursor: pointer; display: block; padding: 5px 0;">
          ▶ {{ nav_item.title }}
        </span>

        <!-- 하위 카테고리 목록 공간 (기본 상태는 펼쳐진 block 상태) -->
        <ul id="menu-{{ nav_item.title | slugify }}" style="display: block; padding-left: 15px; padding-top: 5px; padding-bottom: 5px;">
          
          {% for i in (1..categories_max) reversed %}
            {% for category in site.categories %}
              {% assign target_title = nav_item.title | downcase %}
              {% assign current_category = category | downcase %}
              
              {% if current_category == target_title and category.size == i %}
                <li style="list-style: none; margin-bottom: 5px;">
                  <a href="/categories/#{{ category | slugify }}">
                    <strong style="font-size: 15px;">{{ category }}</strong> 
                    <span class="taxonomy__count" style="font-size: 13px; color: #999;">({{ i }})</span>
                  </a>
                </li>
              {% endif %}
            {% endfor %}
          {% endfor %}
          
        </ul>
      </li>
    {% endfor %}
  </ul>
</nav>
