<!-- navigation 변수 가져오기 -->
{% assign navigation = site.data.navigation[include.nav] %}

<!-- 카테고리 포스트 수 MAX 값 -->
{% assign categories_max = 0 %}
{% for category in site.categories %}
  {% if category[1].size > categories_max %}
    {% assign categories_max = category[1].size %}
  {% endif %}
{% endfor %}

<!-- TAG 포스트 수 MAX 값 -->
{% assign tags_max = 0 %}
{% for tag in site.tags %}
  {% if tag[1].size > tags_max %}
    {% assign tags_max = tag[1].size %}
  {% endif %}
{% endfor %}

<nav class="nav__list">
  <!-- 첫 카테고리 활성화 됐을 때 -->
  {% if navigation[0].use %}
  <!-- 접기/펼치기 토글 버튼 -->
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ site.data.ui-text[site.locale].menu_label | default: "Toggle Menu" }}</label>

  <ul class="nav__items">
    <!-- [수정] 클릭하면 자바스크립트 함수를 실행하도록 onclick과 커서 모양 스타일을 추가했습니다 -->
    <span class="nav__sub-title" onclick="toggleCategory('nav-categories')" style="cursor: pointer;">
      ▶ {{ navigation[0].title }}
    </span>
    <!-- [수정] 기본 상태에서 열려있거나 닫혀있도록 id와 display 스타일을 추가했습니다 -->
    <li id="nav-categories" style="display: block;">
      <!-- 카테고리 리스트 : 포스트 많은 순 정렬 -->
      {% for i in (1..categories_max) reversed %}
        {% for category in site.categories %}
          {% if category[1].size == i %}
            <ul style="padding-top: 0px; padding-bottom: 0px;">
              <a href="/categories/#{{ category[0] | slugify }}">
                <strong style="font-size: 16px;">{{ category[0] }}</strong> <span class="taxonomy__count" style="font-size: 14px;">{{ i }}</span>
              </a>
            </ul>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </li>
  </ul>
  {% endif %}

  {% if navigation[1].use %}
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ site.data.ui-text[site.locale].menu_label | default: "Toggle Menu" }}</label>
  <ul class="nav__items">
    <!-- [수정] 태그 메뉴도 클릭 시 여닫히도록 똑같이 처리했습니다 -->
    <span class="nav__sub-title" onclick="toggleCategory('nav-tags')" style="cursor: pointer;">
      ▶ {{ navigation[1].title }}
    </span>
    <li id="nav-tags" style="display: block;">
    {% for i in (1..tags_max) reversed %}
      {% for tag in site.tags %}
        {% if tag[1].size == i %}
          <ul style="padding-top: 0px; padding-bottom: 0px;">
            <a href="/tags/#{{ tag[0] | slugify }}">
              <strong style="font-size: 16px;">{{ tag[0] }}</strong> <span class="taxonomy__count" style="font-size: 14px;">{{ i }}</span>
            </a>
          </ul>
        {% endif %}
      {% endfor %}
    {% endfor %}
    </li>
  </ul>
  {% endif %}
</nav>
